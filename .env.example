# WDA (WebDriverAgent) URL (iPhone'un IP adresi veya tidevice ile localhost)
WDA_URL=http://localhost:8100

# LLM Sağlayıcısı: "gemini" veya "openai"
AI_PROVIDER=gemini

# API Anahtarları
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Model Seçimi
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o
